# Local development bot (long polling). On Vercel these same values are set as
# Environment Variables in the project dashboard instead - never commit the real
# token to git.

# Token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public https URL serving the Mini App.
# Development: your tunnel, e.g. https://abcd-1234.trycloudflare.com
# Production:  https://your-project.vercel.app
WEBAPP_URL=https://example.trycloudflare.com

# Port for the local order API
PORT=8787

# Browser origin allowed to call the local API ('*' is fine for a local demo).
ALLOWED_ORIGIN=*

# Shared secret Telegram echoes back on every webhook call (Vercel only).
# `npm run webhook -- set <url>` picks this up from here.
WEBHOOK_SECRET=

SHOP_NAME=Forever
