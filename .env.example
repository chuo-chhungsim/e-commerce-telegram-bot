# Front-end env only. Vite inlines every VITE_* value into the public bundle,
# so the bot token must never appear in this file.

# Where the order API lives.
#   Local development : http://localhost:8787   (the bot/ server)
#   Vercel            : leave empty — the Mini App and /api/order share a domain
VITE_API_URL=http://localhost:8787

# Set after BotFather /newapp: https://t.me/<bot_username>/<short_name>
# Used by the product "share" button.
VITE_BOT_LINK=

# Where the "Chat With Support" button on the Contact page goes.
VITE_SUPPORT_LINK=https://t.me/telegram

# --- Demo payment (KHQR / ABA) ------------------------------------------------

# 'link' (default): the QR holds this app's /api/pay URL, so scanning it with a
#   phone camera really does complete the checkout.
# 'khqr': the QR holds a genuine KHQR payload, so a banking app reads the
#   merchant and amount - but nothing can confirm the transfer without a Bakong
#   merchant account, so only the tap fallback settles it.
VITE_QR_MODE=link

# Shown on the QR card, and used when VITE_QR_MODE=khqr.
VITE_KHQR_MERCHANT=Forever
VITE_KHQR_ACCOUNT=forever_demo@bkrt

# Tapping the QR card settles the payment immediately - a safety net for a live
# demo when the camera or the network misbehaves. Set to 0 to require a real scan.
VITE_DEMO_PAY_TAP=1
